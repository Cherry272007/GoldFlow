# Copy to .env and fill in your real values. .env is gitignored - never commit it.

# Private GoldFlow API key (optional auth for POST analyze endpoints)
# When set, the frontend must send it as X-GoldFlow-Key from VITE_GOLDFLOW_API_KEY.
GOLDFLOW_API_KEY=
GOLDFLOW_DB=/tmp/goldflow.db

# --- AI: OpenRouter (only provider) ---
# Free account: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Vision-capable model (needed for screenshot analysis)
OPENROUTER_MODEL=minimax/minimax-m3:free
# AI_TIMEOUT_SECONDS=60
# AI_INTERVAL_MINUTES=0  (0 = AI only on user action)

# --- Market data: MT5 (primary live feed) + London Strategic Edge (candles) ---
# The customer's MetaTrader 5 (GoldFlowEA) POSTs ticks to /api/mt5. Set
# MARKET_PROVIDER=mt5 (or auto) to use that as the primary live price.
# LSE provides 1-minute candles for indicators and a fallback price when MT5
# is stale. Leave LSE_API_KEY empty for an MT5-only deployment.
LSE_API_KEY=
# auto | mt5 | lse | simulated
MARKET_PROVIDER=auto
# MT5 symbol used by the GoldFlowEA (display symbol on the dashboard)
MT5_SYMBOL=XAUUSD
# LSE instrument used for candles/indicators
MARKET_SYMBOL=XAU/USD
# GOLDFLOW_STALE_AFTER=30
# CANDLE_POLL_SECONDS=60
# CANDLES_LIMIT=200

# --- Frontend build (optional, only if GOLDFLOW_API_KEY is set) ---
# VITE_GOLDFLOW_API_KEY=